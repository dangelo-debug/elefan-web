---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import posts from '../../data/blogPosts.json';
import '../../styles/global.css';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Formato del cuerpo (compatible con los artículos antiguos):
//  - un texto normal es un párrafo
//  - un texto que empieza con "## " es un subtítulo
//  - [texto](/ruta) dentro de un párrafo se convierte en enlace
//  - un objeto { "cta": { "texto", "boton", "url" } } es un recuadro de llamado a la acción
const bloques = post.body.map((b) => {
  if (typeof b === 'object' && b.cta) return { tipo: 'cta', ...b.cta };
  if (typeof b === 'string' && b.startsWith('## ')) return { tipo: 'h2', texto: b.slice(3) };
  const partes = [];
  const re = /\[([^\]]+)\]\(([^)]+)\)/g;
  let ultimo = 0, m;
  while ((m = re.exec(b))) {
    if (m.index > ultimo) partes.push({ texto: b.slice(ultimo, m.index) });
    partes.push({ texto: m[1], url: m[2] });
    ultimo = m.index + m[0].length;
  }
  if (ultimo < b.length) partes.push({ texto: b.slice(ultimo) });
  return { tipo: 'p', partes };
});

const textoPlano = post.body
  .map((b) => (typeof b === 'string' ? b.replace(/^## /, '').replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') : ''))
  .join(' ').replace(/\s+/g, ' ').trim();
const metaDescription = post.description
  || (textoPlano.length > 155 ? textoPlano.slice(0, 152).replace(/\s\S*$/, '') + '…' : textoPlano);

const site = Astro.site ?? new URL('https://elefan.cl');
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: metaDescription,
  image: new URL(encodeURI(post.image), site).href,
  ...(post.date ? { datePublished: post.date } : {}),
  author: { '@type': 'Organization', name: 'Agencia Elefan' },
  publisher: { '@type': 'Organization', name: 'Agencia Elefan', logo: { '@type': 'ImageObject', url: new URL('/images/logo-elefan.png', site).href } },
  mainEntityOfPage: new URL(`/blog/${post.slug}/`, site).href,
};
---

<Layout title={(post.seoTitle || post.title) + " | Elefan"} description={metaDescription} image={post.image} jsonLd={jsonLd}>
  <Navbar />
  <div style="padding-top:80px">
    <article class="post">
      <img src={post.image} alt={post.imageAlt || post.title} class="post__img" />
      <h1 class="post__h1">{post.title}</h1>
      {bloques.map((b) => (
        b.tipo === 'h2' ? <h2 class="post__h2">{b.texto}</h2>
        : b.tipo === 'cta' ? (
          <aside class="post__cta">
            <p>{b.texto}</p>
            <a href={b.url}>{b.boton}</a>
          </aside>
        )
        : <p class="post__p">{b.partes.map((pt) => pt.url ? <a href={pt.url}>{pt.texto}</a> : pt.texto)}</p>
      ))}
      <p class="post__tags">{post.tags}</p>
      {post.fuente && (
        <p class="post__fuente">
          Fuente: <a href={post.fuente} target="_blank" rel="noopener noreferrer">{post.fuente}</a>
        </p>
      )}
      <div class="post__volver">
        <a href="/blog/">← Volver al blog</a>
      </div>
    </article>
  </div>
</Layout>

<style>
  .post { max-width: 760px; margin: 0 auto; padding: 80px 40px; }
  .post__img { width: 100%; height: 340px; object-fit: cover; margin-bottom: 40px; display: block; }
  .post__h1 { font-size: 2.2rem; font-weight: 900; color: #1a1a1a; line-height: 1.25; margin-bottom: 32px; }
  .post__h2 { font-size: 1.5rem; font-weight: 900; color: #1a1a1a; line-height: 1.3; margin: 48px 0 18px; }
  .post__p { font-size: 1.05rem; color: #444; line-height: 1.9; font-weight: 300; margin-bottom: 24px; }
  .post__p a { color: #1a1a1a; text-decoration: underline; text-decoration-color: #f5c518; text-decoration-thickness: 3px; text-underline-offset: 4px; }
  .post__cta { background: #f8f5ee; border-left: 6px solid #f5c518; padding: 28px 32px; margin: 40px 0; }
  .post__cta p { font-size: 1.1rem; line-height: 1.7; color: #1a1a1a; margin-bottom: 18px; }
  .post__cta a { display: inline-block; background: #f5c518; color: #1a1a1a; padding: 14px 24px; text-decoration: none; font-weight: 900; }
  .post__cta a:hover { background: #1a1a1a; color: #f5c518; }
  .post__tags { font-size: 0.85rem; color: #c8860a; font-weight: 700; letter-spacing: 1px; margin: 32px 0; }
  .post__fuente { font-size: 0.85rem; color: #888; font-weight: 300; margin-bottom: 48px; }
  .post__fuente a { color: #c8860a; text-decoration: underline; }
  .post__volver { padding-top: 32px; border-top: 1px solid #eee; }
  .post__volver a { font-size: 0.8rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: #1a1a1a; text-decoration: none; }
  @media (max-width: 768px) {
    .post { padding: 48px 24px; }
    .post__img { height: 220px; }
    .post__h1 { font-size: 1.8rem; }
  }
</style>
