---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import projects from '../../data/projects.json';
import { landings, pasos, logos } from '../../data/landings.js';
import '../../styles/global.css';

export function getStaticPaths() {
  return landings.map((landing) => ({ params: { slug: landing.slug }, props: { landing } }));
}

const { landing } = Astro.props;
const site = Astro.site ?? new URL('https://elefan.cl');
const pageUrl = new URL(`/soluciones/${landing.slug}`, site).href;

const casos = landing.casos
  .map((c) => {
    const p = projects.find((x) => x.slug === c.slug);
    return p ? { ...c, titulo: p.title.replace(/\s*[:–-]\s*$/, ''), imagen: p.heroImage || p.image } : null;
  })
  .filter(Boolean);

const otras = landings.filter((l) => l.slug !== landing.slug);
const waLink = `https://wa.me/56996265972?text=${encodeURIComponent(landing.whatsapp)}`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: landing.nombreCorto,
    description: landing.seoDescription,
    url: pageUrl,
    areaServed: 'CL',
    provider: { '@type': 'Organization', name: 'Agencia Elefan', url: site.href },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: landing.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.href },
      { '@type': 'ListItem', position: 2, name: 'Servicios', item: new URL('/servicios', site).href },
      { '@type': 'ListItem', position: 3, name: landing.nombreCorto, item: pageUrl },
    ],
  },
];
---

<Layout title={landing.seoTitle} description={landing.seoDescription} image={landing.heroImage} jsonLd={jsonLd}>
  <Navbar />
  <main class="sol">

    <div class="sol-hero-bg"><section class="sol-hero">
      <div class="sol-hero__copy">
        <nav class="sol-crumbs" aria-label="Ruta de navegación">
          <a href="/servicios">Servicios</a> <span aria-hidden="true">/</span> <span>{landing.nombreCorto}</span>
        </nav>
        <h1 class="sol-hero__title">{landing.h1}</h1>
        <p class="sol-hero__intro">{landing.intro}</p>
        <div class="sol-actions">
          <a class="btn btn--yellow" href={waLink} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
          <a class="btn btn--line" href="#casos">Ver casos</a>
        </div>
        {landing.aviso && <p class="sol-hero__aviso">{landing.aviso}</p>}
      </div>
      <figure class="sol-hero__media">
        <img src={landing.heroImage} alt={landing.heroAlt} width="900" height="680" fetchpriority="high" />
      </figure>
    </section></div>

    <section class="sol-logos" aria-label="Empresas que han trabajado con Elefan">
      <p>Empresas que han confiado en nosotros</p>
      <ul>
        {logos.map((l) => <li><img src={l.src} alt={l.alt} class={l.oscuro ? 'oscuro' : undefined} loading="lazy" /></li>)}
      </ul>
    </section>

    <section class="sol-problema">
      <div class="sol-wrap sol-problema__grid">
        <h2>{landing.problemaTitulo}</h2>
        <div>{landing.problema.map((p) => <p>{p}</p>)}</div>
      </div>
    </section>

    <section class="sol-formatos sol-wrap">
      <h2 class="sol-h2">Qué podemos hacer por ti</h2>
      <dl>
        {landing.formatos.map((f) => (
          <div class="sol-formato">
            <dt>{f.titulo}</dt>
            <dd>{f.texto}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="sol-casos" id="casos">
      <div class="sol-wrap">
        <h2 class="sol-h2">Casos</h2>
        <div class="sol-casos__grid">
          {casos.map((c) => (
            <a class="sol-caso" href={`/proyectos/${c.slug}`}>
              <img src={c.imagen} alt="" loading="lazy" />
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
              <span class="sol-caso__link">Ver el caso completo</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="sol-pasos sol-wrap">
      <h2 class="sol-h2">Cómo trabajamos</h2>
      <ol>
        {pasos.map((p, i) => (
          <li>
            <span class="sol-pasos__n" aria-hidden="true">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="sol-faq sol-wrap">
      <h2 class="sol-h2">Preguntas frecuentes</h2>
      {landing.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="sol-cta" id="contacto">
      <div class="sol-wrap sol-cta__grid">
        <div>
          <h2>Conversemos tu proyecto</h2>
          <p>Cuéntanos qué necesitas y te respondemos pronto. Si prefieres, escríbenos directo por WhatsApp.</p>
          <a class="btn btn--yellow" href={waLink} target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a>
          <p class="sol-cta__mail">O al correo <a href="mailto:hola@elefan.cl">hola@elefan.cl</a></p>
        </div>
        <form action="https://formspree.io/f/mykqdrev" method="POST" class="sol-form">
          <input type="hidden" name="_subject" value={`Nuevo contacto web: ${landing.nombreCorto}`} />
          <input type="hidden" name="origen" value={`/soluciones/${landing.slug}`} />
          <label>Nombre<input name="nombre" type="text" autocomplete="name" required /></label>
          <label>Empresa<input name="empresa" type="text" autocomplete="organization" /></label>
          <label>Correo<input name="email" type="email" autocomplete="email" required /></label>
          <label>¿Qué necesitas?<textarea name="mensaje" rows="4" required></textarea></label>
          <button type="submit" class="btn btn--yellow">Enviar mensaje</button>
        </form>
      </div>
    </section>

    <nav class="sol-otras sol-wrap" aria-label="Otras soluciones">
      <h2 class="sol-h2">También hacemos</h2>
      <ul>
        {otras.map((o) => <li><a href={`/soluciones/${o.slug}`}>{o.nombreCorto}</a></li>)}
        <li><a href="/servicios">Todos los servicios</a></li>
      </ul>
    </nav>

  </main>

  <footer class="sol-footer">
    <img src="/images/logo-elefan.png" alt="Elefan" />
    <p>Agencia Elefan, Santiago de Chile. <a href="mailto:hola@elefan.cl">hola@elefan.cl</a></p>
  </footer>
</Layout>

<style>
  .sol {
    --ink: #1a1a1a;
    --cream: #f8f5ee;
    --yellow: #f5c518;
    --gold: #a86f00;
    --muted: #555;
    --line: #e4dfd3;
    color: var(--ink);
    padding-top: 80px;
  }
  .sol-wrap { max-width: 1120px; margin: 0 auto; padding-left: 40px; padding-right: 40px; }
  .sol-h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 900; line-height: 1.15; margin-bottom: 40px; }

  /* Botones */
  .btn {
    display: inline-block; padding: 16px 28px; font-weight: 900; font-size: 0.95rem;
    text-decoration: none; border: 2px solid var(--ink); cursor: pointer; font-family: inherit;
  }
  .btn--yellow { background: var(--yellow); color: var(--ink); border-color: var(--yellow); }
  .btn--yellow:hover { background: var(--ink); color: var(--yellow); border-color: var(--ink); }
  .btn--line { background: transparent; color: var(--ink); }
  .btn--line:hover { background: var(--ink); color: white; }
  .sol a:focus-visible, .sol button:focus-visible, .sol summary:focus-visible,
  .sol input:focus-visible, .sol textarea:focus-visible { outline: 3px solid var(--gold); outline-offset: 3px; }

  /* Hero: el único gesto fuerte de la página, la imagen apoyada en un bloque amarillo */
  .sol-hero-bg { background: var(--cream); }
  .sol-hero {
    display: grid; grid-template-columns: 1.05fr 1fr; gap: 64px; align-items: center;
    padding: 72px 40px 96px; max-width: 1280px; margin: 0 auto;
  }
  .sol-crumbs { font-size: 0.85rem; color: var(--muted); margin-bottom: 28px; }
  .sol-crumbs a { color: var(--muted); }
  .sol-hero__title { font-size: clamp(2.3rem, 5vw, 4.2rem); font-weight: 900; line-height: 1.04; letter-spacing: -0.01em; margin-bottom: 28px; max-width: 14ch; }
  .sol-hero__intro { font-size: 1.15rem; font-weight: 300; line-height: 1.7; color: #333; max-width: 52ch; margin-bottom: 36px; }
  .sol-actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .sol-hero__aviso { margin-top: 28px; font-size: 0.95rem; color: var(--ink); border-left: 4px solid var(--yellow); padding-left: 14px; max-width: 48ch; }
  .sol-hero__media { position: relative; margin: 0; }
  .sol-hero__media::before { content: ""; position: absolute; inset: 28px -28px -28px 28px; background: var(--yellow); }
  .sol-hero__media img { position: relative; display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }

  /* Logos */
  .sol-logos { background: var(--ink); padding: 56px 40px 8px; text-align: center; }
  .sol-logos p { font-size: 0.95rem; color: #9a9a9a; margin-bottom: 28px; }
  .sol-logos ul { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 28px 48px; max-width: 1100px; margin: 0 auto; }
  .sol-logos img { height: 34px; width: auto; max-width: 120px; object-fit: contain; opacity: 0.85; }
  .sol-logos img.oscuro { filter: invert(1); }

  /* Problema */
  .sol-problema { background: var(--ink); color: white; padding: 72px 0 96px; }
  .sol-problema .sol-wrap { border-top: 1px solid #333; padding-top: 72px; }
  .sol-problema__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .sol-problema h2 { font-size: clamp(1.7rem, 3.2vw, 2.5rem); font-weight: 900; line-height: 1.15; }
  .sol-problema p { font-size: 1.1rem; font-weight: 300; line-height: 1.8; color: #d6d6d6; margin-bottom: 20px; max-width: 56ch; }

  /* Formatos */
  .sol-formatos { padding-top: 96px; padding-bottom: 72px; }
  .sol-formatos dl { display: grid; grid-template-columns: 1fr 1fr; column-gap: 64px; }
  .sol-formato { padding: 28px 0; border-top: 1px solid var(--line); }
  .sol-formato dt { font-size: 1.25rem; font-weight: 900; margin-bottom: 10px; }
  .sol-formato dd { font-weight: 300; line-height: 1.75; color: var(--muted); max-width: 52ch; }

  /* Casos */
  .sol-casos { background: var(--cream); padding: 96px 0; }
  .sol-casos__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
  .sol-caso { color: var(--ink); text-decoration: none; display: flex; flex-direction: column; }
  .sol-caso img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; margin-bottom: 20px; background: #ddd; }
  .sol-caso h3 { font-size: 1.15rem; font-weight: 900; line-height: 1.3; margin-bottom: 10px; }
  .sol-caso p { font-weight: 300; line-height: 1.7; color: var(--muted); margin-bottom: 16px; }
  .sol-caso__link { margin-top: auto; font-weight: 700; font-size: 0.95rem; text-decoration: underline; text-decoration-color: var(--yellow); text-decoration-thickness: 3px; text-underline-offset: 5px; }
  .sol-caso:hover h3 { text-decoration: underline; }

  /* Pasos: es una secuencia real, por eso va numerada */
  .sol-pasos { padding-top: 96px; padding-bottom: 72px; }
  .sol-pasos ol { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .sol-pasos__n { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; background: var(--yellow); font-weight: 900; margin-bottom: 18px; }
  .sol-pasos h3 { font-size: 1.15rem; font-weight: 900; margin-bottom: 10px; }
  .sol-pasos p { font-weight: 300; line-height: 1.7; color: var(--muted); }

  /* FAQ */
  .sol-faq { padding-top: 24px; padding-bottom: 96px; }
  .sol-faq details { max-width: 860px; }
  .sol-faq details { border-top: 1px solid var(--line); }
  .sol-faq details:last-of-type { border-bottom: 1px solid var(--line); }
  .sol-faq summary { cursor: pointer; padding: 22px 40px 22px 0; font-size: 1.1rem; font-weight: 700; list-style: none; position: relative; }
  .sol-faq summary::-webkit-details-marker { display: none; }
  .sol-faq summary::after { content: "+"; position: absolute; right: 4px; top: 16px; font-size: 1.6rem; font-weight: 300; }
  .sol-faq details[open] summary::after { content: "–"; }
  .sol-faq details p { padding: 0 0 24px; font-weight: 300; line-height: 1.75; color: var(--muted); max-width: 64ch; }

  /* CTA y formulario */
  .sol-cta { background: #2d2d2d; color: white; padding: 96px 0; }
  .sol-cta__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: start; }
  .sol-cta h2 { font-size: clamp(1.8rem, 3.5vw, 2.8rem); font-weight: 900; color: var(--yellow); line-height: 1.1; margin-bottom: 20px; }
  .sol-cta p { color: #ccc; font-weight: 300; line-height: 1.7; margin-bottom: 28px; max-width: 44ch; }
  .sol-cta__mail { margin-top: 24px; }
  .sol-cta__mail a { color: var(--yellow); }
  .sol-form { display: flex; flex-direction: column; gap: 22px; }
  .sol-form label { display: flex; flex-direction: column; gap: 8px; font-size: 0.9rem; color: #bbb; }
  .sol-form input, .sol-form textarea {
    background: transparent; border: none; border-bottom: 1px solid #666; padding: 10px 0;
    color: white; font-size: 1rem; font-family: inherit; resize: vertical;
  }
  .sol-form input:focus, .sol-form textarea:focus { border-bottom-color: var(--yellow); outline: none; }
  .sol-form .btn { align-self: flex-start; margin-top: 8px; }

  /* Otras soluciones */
  .sol-otras { padding-top: 72px; padding-bottom: 72px; }
  .sol-otras ul { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; }
  .sol-otras a { display: inline-block; padding: 12px 20px; border: 2px solid var(--ink); color: var(--ink); text-decoration: none; font-weight: 700; }
  .sol-otras a:hover { background: var(--yellow); border-color: var(--yellow); }

  .sol-footer { background: var(--ink, #1a1a1a); padding: 36px 40px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
  .sol-footer img { height: 36px; filter: invert(1); }
  .sol-footer p { color: #888; font-size: 0.9rem; font-weight: 300; }
  .sol-footer a { color: #f5c518; }

  @media (max-width: 960px) {
    .sol-hero { grid-template-columns: 1fr; gap: 56px; padding: 40px 24px 72px; }
    .sol-hero__media { margin-right: 28px; }
    .sol-problema__grid, .sol-cta__grid, .sol-formatos dl { grid-template-columns: 1fr; gap: 32px; }
    .sol-casos__grid { grid-template-columns: 1fr; gap: 48px; }
    .sol-pasos ol { grid-template-columns: 1fr 1fr; }
    .sol-wrap { padding-left: 24px; padding-right: 24px; }
  }
  @media (max-width: 768px) {
    .sol-pasos ol { grid-template-columns: 1fr; }
    .sol-problema, .sol-casos, .sol-cta { padding: 64px 0; }
    .sol-formatos, .sol-pasos { padding-top: 64px; }
  }
  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
</style>
